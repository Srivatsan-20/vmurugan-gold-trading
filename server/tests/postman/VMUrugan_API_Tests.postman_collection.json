            "url": {
              "raw": "{{baseUrl}}/transactions/customer/{{customerId}}?page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["transactions", "customer", "{{customerId}}"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
